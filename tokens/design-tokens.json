{
  "color": {
    "bg": {
      "$type": "color",
      "$value": {
        "dark": "#0c0d0f",
        "light": "#f4f3ef"
      }
    },
    "surface": {
      "$type": "color",
      "$value": {
        "dark": "#121317",
        "light": "#faf9f6"
      }
    },
    "border": {
      "$type": "color",
      "$value": {
        "dark": "#292b30",
        "light": "#d4d2cc"
      }
    },
    "text": {
      "$type": "color",
      "$value": {
        "dark": "#f2f1ec",
        "light": "#101010"
      }
    },
    "muted": {
      "$type": "color",
      "$value": {
        "dark": "#a8a8a2",
        "light": "#595959"
      }
    },
    "violet": {
      "$type": "color",
      "$value": {
        "dark": "#9875ff",
        "light": "#8155ff"
      }
    },
    "lime": {
      "$type": "color",
      "$value": {
        "dark": "#d7ff3f",
        "light": "#d7ff3f"
      }
    },
    "lime-ink": {
      "$type": "color",
      "$value": {
        "dark": "#d7ff3f",
        "light": "#5f7f00"
      }
    },
    "on-lime": {
      "$type": "color",
      "$value": {
        "dark": "#101010",
        "light": "#101010"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Geist",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 800,
        "fontSize": "96px",
        "letterSpacing": "-0.04em",
        "lineHeight": 0.95,
        "textCase": "uppercase"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 800,
        "fontSize": "40px",
        "letterSpacing": "-0.035em",
        "lineHeight": 1.05
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 700,
        "fontSize": "26px",
        "letterSpacing": "-0.02em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": "16px",
        "lineHeight": 1.5
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 400,
        "fontSize": "12px",
        "letterSpacing": "0.12em",
        "textCase": "uppercase"
      }
    },
    "data": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 700,
        "fontSize": "12px",
        "letterSpacing": "0.1em",
        "textCase": "uppercase"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "layout": {
    "grid": {
      "$type": "dimension",
      "$value": "40px"
    },
    "radius": {
      "$type": "dimension",
      "$value": "0"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "shell-max": {
      "$type": "dimension",
      "$value": "1500px"
    },
    "header-height": {
      "$type": "dimension",
      "$value": "76px"
    }
  },
  "motion": {
    "ease-out-expo": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "ease-standard": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        0.2,
        1
      ]
    },
    "rise": {
      "$type": "duration",
      "$value": "900ms"
    },
    "draw": {
      "$type": "duration",
      "$value": "1600ms"
    },
    "flow": {
      "$type": "duration",
      "$value": "900ms"
    },
    "pulse": {
      "$type": "duration",
      "$value": "2200ms"
    },
    "spin": {
      "$type": "duration",
      "$value": "14s"
    },
    "fast": {
      "$type": "duration",
      "$value": "150ms"
    }
  }
}